# Server
PORT=3001
NODE_ENV=development

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/myapp

# JWT Authentication (required)
# JWT_ACCESS_SECRET must be at least 32 characters — signs short-lived access tokens.
# Refresh tokens are opaque random bytes (not JWTs) and are not signed.
JWT_ACCESS_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=60m
REFRESH_TOKEN_TTL_DAYS=90

# S3 Storage (required)
S3_ENDPOINT=https://your-s3-endpoint.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_MEDIA=your-media-bucket-name

# LLM A/B/C/D/E variant selector: A = OpenAI (default), B/C = DeepSeek V4
# Flash/Pro via OpenRouter, E = gpt-oss-120b via OpenRouter (B/C pinned to Atlas
# Cloud, E to DeepInfra), D = split pools on Azure AI Foundry: GPT-5.4-nano for
# cleaning + DeepSeek V4 Flash for the eight analysis stages — so D is the only
# variant needing TWO pools. Selects a stage→model profile (llm/model-variants.ts).
LLM_VARIANT=A

# ─── LLM credentials ─────────────────────────────────────────────────────────
#
# All LLM credentials are configured PER POOL, with the SAME indexed shape for
# every provider:
#
#     <PREFIX>_API_KEY_<i>      <PREFIX>_BASE_URL_<i>       (i = 1..8)
#
# A pool is a set of interchangeable keys sharing one quota policy
# (llm/llm-pools.ts). Each key in a pool carries its own quota and gets its own
# rate limiter; traffic is sharded across a pool's keys by conversation. Set BOTH
# vars of a pair, or neither — a half-configured pair fails at startup.
#
# Only the pools the ACTIVE VARIANT uses are required, and that is enforced at
# boot: A → OPENAI, B/C/E → OPENROUTER,
# D → AZURE_FOUNDRY_INTERACTIVE + AZURE_FOUNDRY_ANALYSIS (both).
#
# Base URL is the OpenAI-compatible surface. It is explicit rather than implied
# so that adding a second key to ANY pool is purely configuration.
#
# ONE RULE FOR EVERY POOL: each endpoint in a pool must carry its OWN QUOTA.
# Extra keys add capacity only when they add quota — two keys metered against a
# single cap just build two rate limiters over that one cap, admitting ~2x the
# allowed rate and producing sustained 429s. What "its own quota" means differs:
#
#   AZURE_FOUNDRY_*   → a distinct Azure RESOURCE (distinct base URL). Do NOT use
#                       the two access keys ("Key 1"/"Key 2") of the SAME
#                       resource. Startup ENFORCES this: duplicate base URLs in
#                       one of these pools are rejected.
#
#   OPENAI/OPENROUTER → a distinct ACCOUNT / ORG / PROJECT. These providers meter
#                       per account, NOT per key, so two keys from the same
#                       account share one cap however many you add — the second
#                       buys zero throughput and risks 429s. Startup CANNOT check
#                       this (an API key does not reveal its account), so it is on
#                       you. Sharing one HOST across those keys is normal and
#                       fine; it is the ACCOUNT that must differ.
#
# In practice: leave OPENAI/OPENROUTER at a single key unless you genuinely have
# separate provider accounts. (Startup does reject the same key pasted twice, in
# any pool — but that only catches a duplicated paste, not two keys of one
# account.)
#
# Across Foundry pools a shared base URL is allowed but warned about: it is only
# safe if the two pools target DIFFERENT deployments on that resource.

# OpenAI — required for LLM_VARIANT=A.
OPENAI_API_KEY_1=your-openai-api-key
OPENAI_BASE_URL_1=https://api.openai.com/v1

# OpenRouter — required for LLM_VARIANT=B, C or E.
OPENROUTER_API_KEY_1=your-openrouter-api-key
OPENROUTER_BASE_URL_1=https://openrouter.ai/api/v1

# Azure AI Foundry — required for LLM_VARIANT=D, which uses BOTH pools:
# interactive serves cleaning (nano), analysis serves the eight graph stages.
AZURE_FOUNDRY_INTERACTIVE_API_KEY_1=your-gpt-nano-foundry-api-key
AZURE_FOUNDRY_INTERACTIVE_BASE_URL_1=https://your-nano-resource.services.ai.azure.com/openai/v1/
AZURE_FOUNDRY_ANALYSIS_API_KEY_1=your-first-deepseek-foundry-api-key
AZURE_FOUNDRY_ANALYSIS_BASE_URL_1=https://your-first-resource.services.ai.azure.com/openai/v1/
AZURE_FOUNDRY_ANALYSIS_API_KEY_2=your-second-deepseek-foundry-api-key
AZURE_FOUNDRY_ANALYSIS_BASE_URL_2=https://your-second-resource.services.ai.azure.com/openai/v1/

# ─── LLM rate limits, one cap per pool ───────────────────────────────────────
#
# Each caps outbound structured LLM calls per API KEY, protecting that key's
# quota. A pool's aggregate CAPACITY CEILING = its rate × its key count — a
# ceiling, not a guaranteed rate, since utilization depends on how conversations
# spread across keys. A single conversation is pinned to ONE key, so its own rate
# is bound by the per-key value no matter how many keys exist. Overflow queues
# in-process and drains as the window refreshes. Smoothing
# (minTime = 60000 / rpm) is derived from the cap — no separate min-time setting.
# (AssemblyAI transcription is a separate quota and is not gated by any of these.)
#
# Every cap below HAS a default (the value shown), so omitting one is legal and
# boots at that value — it does NOT fail. A cap is only consulted for a pool the
# active variant actually uses; an unused pool gets no limiter at all.
#
# Set them explicitly anyway if you provision your own Azure resources: 18 is a
# conservative floor (10% under a strict 20 rpm), but 60 and 35 are the numbers
# WE provisioned. Inherit them by accident on a smaller resource and you get
# sustained 429s with nothing at boot to warn you.

# Interactive = the cleaning stage: user-paced, sits between the user sending a
# message and seeing it — and isolated so it never queues behind an analysis burst.
LLM_RPM_INTERACTIVE=60
# Analysis = the eight portfolio-graph stages: machine-paced ~9-call bursts. NB a
# conversation is pinned to one key, so minTime pacing (60000/35 ≈ 1714ms) means a
# 9-call turn spends ~15s pacing. To speed that up raise this cap — adding keys
# raises total concurrency across users, never one journey's speed.
LLM_RPM_ANALYSIS=35
# The account-scoped provider pools. 18 = 10% headroom under a strict 20 req/min.
LLM_RPM_OPENAI=18
LLM_RPM_OPENROUTER=18

# Azure AI Language — PII/PHI redaction (required for the redaction pipeline).
# Authenticated with a Microsoft Entra service principal (no static key), so the
# resource can enforce disableLocalAuth. Endpoint is the Language resource's
# endpoint (e.g. https://<resource>.cognitiveservices.azure.com). The app registration
# needs the "Cognitive Services User" role on the resource.
AZURE_LANGUAGE_ENDPOINT=https://your-language-resource.cognitiveservices.azure.com
AZURE_TENANT_ID=your-entra-tenant-id
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-app-registration-client-secret
# How the PHI layer treats dates. 'keep-relative' (default) keeps non-identifying
# relative time ("today", "three weeks ago") for reflective narrative while still
# redacting absolute dates (DOB, "12/05/1980"). 'redact-all' removes every date.
REDACTION_DATE_POLICY=keep-relative
# Keep PersonType entities (job roles / relationship nouns: "supervisor", "GP",
# "daughter"). Not HIPAA/ICO identifiers, so kept by default. 'false' redacts them.
REDACTION_KEEP_PERSON_TYPE=true

# AssemblyAI (required)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
# AssemblyAI base URL. Defaults to the EU endpoint for UK GDPR data residency
# (audio stays in the EU, no model training). Override only if you have a
# specific reason to route through the US endpoint (https://api.assemblyai.com).
ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com

SENTRY_DSN=your-sentry-dsn

# OpenTelemetry (optional — disabled when absent)
# Grafana Cloud OTLP endpoint and auth header
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceId:apiKey)>

# CORS — comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173

# Reverse-proxy hop count for `req.ip` resolution from X-Forwarded-For.
# 0 = no proxy (local dev). 1 = Render/ALB/Fly. 2 = Cloudflare in front of one proxy.
# Must match deployment topology — used by audit fields (acknowledgement IP).
TRUST_PROXY_HOPS=0

# Transactional email via the Resend SDK (https://resend.com/docs).
# RESEND_API_KEY needs Sending access; MAIL_FROM must be an address on your
# Resend-verified domain. Leave unset locally to disable email sending (no-op).
RESEND_API_KEY=<your-resend-api-key>
MAIL_FROM="logdit <no-reply@logdit.app>"
