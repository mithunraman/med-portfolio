{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "ios": "expo run:ios --device",
    "ios:simulator": "expo run:ios",
    "android": "expo run:android --device",
    "android:emulator": "expo run:android",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "clean": "rm -rf .expo ios android node_modules"
  },
  "dependencies": {
    "@acme/api-client": "workspace:*",
    "@acme/shared": "workspace:*",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^3.9.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react-native": "^7.11.0",
    "expo": "~57.0.4",
    "expo-audio": "~57.0.0",
    "expo-build-properties": "^57.0.3",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "^57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-network": "~57.0.0",
    "expo-print": "~57.0.0",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-web-browser": "^57.0.0",
    "exponential-backoff": "^3.1.3",
    "react": "19.2.3",
    "react-hook-form": "^7.53.0",
    "react-native": "0.86.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0",
    "react-redux": "^9.2.0",
    "zod": "^3.23.8"
  },
  "expo": {
    "install": {
      "//": "typescript pinned to monorepo-wide 5.x; SDK 57 recommends 6.0 but that is a coordinated repo-wide bump, done separately",
      "exclude": ["typescript"]
    }
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.15",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~5.9.2"
  }
}
